---
import { LOGO_PATHS } from "../data/logos";
import { LINE_ICONS as ICONS } from "../data/icons";

interface Props {
  skill: string;
  label: string;
  count: number;
}

const { skill, label, count } = Astro.props;
const logo = LOGO_PATHS[skill];
const countText = `Used in ${count} project${count === 1 ? "" : "s"}`;

// Specialities use a line icon; tech skills use their brand logo instead.
if (!logo && !ICONS[skill])
  throw new Error(`SkillLink: no logo or icon for "${skill}"`);
---

<a
  href={`/work/?skill=${skill}`}
  class="chip skill-link"
  aria-label={`${label}: ${countText.toLowerCase()}`}
>
  {logo ? (
    <svg
      viewBox="0 0 24 24"
      class="size-3.5 shrink-0"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d={logo} />
    </svg>
  ) : (
    <svg
      viewBox="0 0 24 24"
      class="size-4 shrink-0"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={ICONS[skill]}
    />
  )}
  {label}
  <span class="skill-tip" aria-hidden="true">
    {countText}
  </span>
</a>
