---
import { LOGO_PATHS } from "../data/logos";

interface Props {
  skill: string;
  label: string;
  count: number;
}

const { skill, label, count } = Astro.props;
const logo = LOGO_PATHS[skill];
const countText = `Used in ${count} project${count === 1 ? "" : "s"}`;

// Line icons for specialities; tech skills use their brand logo instead.
const ICONS: Record<string, string> = {
  web: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M7 6.5h.01M10 6.5h.01"/>',
  api: '<rect x="3" y="4" width="18" height="7" rx="1.5"/><rect x="3" y="13" width="18" height="7" rx="1.5"/><path d="M7 7.5h.01M7 16.5h.01"/>',
  mobile:
    '<rect x="7" y="2.5" width="10" height="19" rx="2"/><path d="M11 18h2"/>',
  payments:
    '<rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="M2.5 10h19M6 15h4"/>',
  ai: '<path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M19 16l.6 1.4L21 18l-1.4.6L19 20l-.6-1.4L17 18l1.4-.6z"/>',
  seo: '<circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.4-4.4"/>',
};
if (!logo && !ICONS[skill])
  throw new Error(`SkillLink: no logo or icon for "${skill}"`);
---

<a
  href={`/work/?skill=${skill}`}
  class="chip skill-link"
  aria-label={`${label}: ${countText.toLowerCase()}`}
>
  {logo ? (
    <svg
      viewBox="0 0 24 24"
      class="size-3.5 shrink-0"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d={logo} />
    </svg>
  ) : (
    <svg
      viewBox="0 0 24 24"
      class="size-4 shrink-0"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={ICONS[skill]}
    />
  )}
  {label}
  <span class="skill-tip" aria-hidden="true">
    {countText}
  </span>
</a>
