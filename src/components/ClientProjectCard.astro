---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { hire } from "../data/copy";
import { profile } from "../data/profile";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const c = project.data.client;
if (!c)
  throw new Error(`ClientProjectCard: "${project.id}" has no client block`);

const href = `/work/${project.id}/`;
const subject = `Project enquiry: ${c.title}`;
const mail = `mailto:${profile.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(hire.mailBody)}`;
---

<article
  class="card card-hover reveal flex flex-col overflow-hidden"
  aria-labelledby={`c-${project.id}`}
>
  {c.cover && (
    <a
      href={href}
      class="card-media block overflow-hidden border-b border-line bg-surface-2"
      tabindex="-1"
      aria-hidden="true"
    >
      <Image
        src={c.cover}
        alt=""
        widths={[480, 800, 1200]}
        sizes="(min-width: 768px) 34rem, 100vw"
        loading="lazy"
        class="aspect-[16/9] w-full object-cover"
      />
    </a>
  )}
  <div class="flex flex-1 flex-col gap-4 p-5 sm:p-6">
    <div>
      <p class="eyebrow">{c.category}</p>
      <h3 id={`c-${project.id}`} class="mt-1 text-xl font-semibold">
        <a href={href} class="no-underline hover:underline">
          {c.title}
        </a>
      </h3>
      <p class="mt-2 text-ink-2">{c.story}</p>
    </div>
    <div>
      <h4 class="text-sm font-semibold text-ink">My contribution</h4>
      <p class="mt-1 text-ink-2">{c.contribution}</p>
      {c.note && <p class="mt-1 text-sm text-muted">{c.note}</p>}
    </div>
    <ul class="flex flex-wrap gap-1.5" aria-label="Technologies">
      {c.tags.map((t) => (
        <li class="chip">{t}</li>
      ))}
    </ul>
    <a
      href={mail}
      class="btn btn-primary mt-auto min-h-11 justify-center sm:self-start"
    >
      Contact me about this project
    </a>
  </div>
</article>
