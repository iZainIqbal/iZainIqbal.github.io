---
import { getCollection, getEntries } from "astro:content";
import { formatPeriod } from "../lib/format";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const entries = (await getCollection("experience")).sort((a, b) =>
  b.data.start.localeCompare(a.data.start),
);
const withProjects = await Promise.all(
  entries.map(async (e) => ({ e, projects: await getEntries(e.data.projects) })),
);
---

<ol class="timeline reveal grid gap-8 pl-6">
  {
    withProjects.map(({ e, projects }) => (
      <li class="reveal relative">
        <span
          class:list={[
            "dot absolute -left-[1.84rem] top-1.5 size-3 rounded-full border-2 border-bg",
            e.data.end === "present" ? "dot-current bg-accent" : "bg-team",
          ]}
          aria-hidden="true"
        />
        <p class="eyebrow">{formatPeriod(e.data.start, e.data.end)}</p>
        <h3 class="mt-1 text-lg font-semibold">
          {e.data.title} <span class="font-normal text-muted">· {e.data.org}</span>
        </h3>
        {!compact && <p class="text-sm text-muted">{e.data.place}</p>}
        <p class="mt-1 max-w-[68ch] text-ink-2">{e.data.summary}</p>
        {projects.length > 0 && (
          <p class="mt-2 text-sm text-muted">
            Projects:{" "}
            {projects.map((p, i) => (
              <>
                {i > 0 && ", "}
                <a href={`/work/${p.id}/`} class="text-ink-2 hover:text-ink">
                  {p.data.title}
                </a>
              </>
            ))}
          </p>
        )}
      </li>
    ))
  }
</ol>

<script>
  // Scroll progress for the timeline: fills the rail and marks the entries the
  // reading line has passed. Only runs when the visitor allows motion.
  const READING_LINE = 0.6; // share of the viewport height
  const timelines = document.querySelectorAll<HTMLElement>(".timeline");

  if (
    timelines.length &&
    document.documentElement.classList.contains("js-motion")
  ) {
    let queued = false;

    const update = () => {
      queued = false;
      const line = innerHeight * READING_LINE;
      const atPageEnd =
        scrollY + innerHeight >= document.documentElement.scrollHeight - 2;

      timelines.forEach((tl) => {
        const box = tl.getBoundingClientRect();
        const progress = atPageEnd
          ? 1
          : Math.min(1, Math.max(0, (line - box.top) / box.height));
        tl.style.setProperty("--tl-progress", progress.toFixed(3));

        const items = [...tl.querySelectorAll<HTMLElement>(":scope > li")];
        const reached = items.map(
          (li) => atPageEnd || li.getBoundingClientRect().top <= line,
        );
        const active = reached.lastIndexOf(true);
        items.forEach((li, i) => {
          li.classList.toggle("is-reached", reached[i]);
          li.classList.toggle("is-active", i === active);
        });
      });
    };

    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };

    addEventListener("scroll", onScroll, { passive: true });
    addEventListener("resize", onScroll, { passive: true });
    update();
  }
</script>
