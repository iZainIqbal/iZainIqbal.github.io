---
import Base from "../layouts/Base.astro";
import { hire } from "../data/copy";
import { profile } from "../data/profile";

const mail = `mailto:${profile.email}?subject=${encodeURIComponent("Project enquiry")}&body=${encodeURIComponent(hire.mailBody)}`;
---

<Base title="Hire me" description={hire.metaDescription}>
  <section class="container-page hero-in pt-14 pb-12 sm:pt-20">
    <p class="eyebrow">For clients</p>
    <h1 class="mt-3 max-w-[20ch] text-4xl font-bold sm:text-5xl">{hire.title}</h1>
    <p class="mt-5 max-w-[58ch] text-lg text-ink-2">{hire.lede}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={mail} class="btn btn-primary">Email me about your project</a>
      <a href="#how" class="btn btn-ghost">How we’d work together</a>
    </div>
  </section>

  <section class="container-page py-10" aria-labelledby="svc-h">
    <h2 id="svc-h" class="text-2xl font-bold sm:text-3xl">{hire.specialitiesTitle}</h2>
    <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        hire.services.map((s) => (
          <li class="card card-hover reveal p-6">
            <h3 class="text-lg font-semibold">{s.title}</h3>
            <p class="mt-2 text-ink-2">{s.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="how" class="container-page scroll-mt-20 py-10" aria-labelledby="how-h">
    <h2 id="how-h" class="text-2xl font-bold sm:text-3xl">How we’d work together</h2>
    <ol class="mt-6 grid gap-5 md:grid-cols-4">
      {
        hire.steps.map((s, i) => (
          <li class="card card-hover reveal p-5">
            <span class="font-mono text-sm text-accent">0{i + 1}</span>
            <h3 class="mt-2 font-semibold">{s.title}</h3>
            <p class="mt-1 text-sm text-ink-2">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </section>


  <section class="container-page py-10">
    <div class="card reveal flex flex-col gap-5 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
      <div>
        <h2 class="text-2xl font-bold">{hire.closingTitle}</h2>
        <p class="mt-1 text-ink-2">{hire.closingText}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={mail} class="btn btn-primary">Email me about your project</a>
        <button type="button" class="btn btn-ghost" data-copy={profile.email}>Copy email address</button>
      </div>
    </div>
  </section>
</Base>

<script>
  // For visitors without a mail app: copy the address instead of opening mailto.
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const label = btn.textContent;
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? "");
        btn.textContent = "Copied ✓";
      } catch {
        btn.textContent = btn.dataset.copy ?? "";
      }
      setTimeout(() => (btn.textContent = label), 2500);
    });
  });
</script>
