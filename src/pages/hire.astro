---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import ClientProjectCard from "../components/ClientProjectCard.astro";
import portrait from "../assets/profilepicture.webp";
import { hire } from "../data/copy";
import { profile } from "../data/profile";
import { formatPeriod } from "../lib/format";

const mail = `mailto:${profile.email}?subject=${encodeURIComponent("Project enquiry")}&body=${encodeURIComponent(hire.mailBody)}`;

// Projects with a client block, in the order set there. Cards with a cover go
// first, so each row of the two-column grid holds matching cards.
const clientProjects = (await getCollection("projects"))
  .filter((p) => p.data.client)
  .sort((a, b) => a.data.client!.order - b.data.client!.order);
const cards = [
  ...clientProjects.filter((p) => p.data.client!.cover),
  ...clientProjects.filter((p) => !p.data.client!.cover),
];
const experience = (await getCollection("experience")).sort((a, b) =>
  b.data.start.localeCompare(a.data.start),
);
---

<Base title="Hire me" description={hire.metaDescription}>
  <section class="container-page grid items-center gap-10 pt-14 pb-12 sm:pt-20 lg:grid-cols-[1fr_15rem]">
    <div class="hero-in">
      <p class="eyebrow">For clients</p>
      <h1 class="mt-3 max-w-[19ch] text-4xl font-bold sm:text-5xl">{hire.title}</h1>
      <p class="mt-5 max-w-[58ch] text-lg text-ink-2">{hire.lede}</p>
      <p class="mt-4 font-mono text-sm text-muted">{hire.capabilities}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={mail} class="btn btn-primary min-h-11">Discuss your project</a>
        <a href="#work" class="btn btn-ghost min-h-11">Explore my work</a>
      </div>
    </div>
    <div class="hero-photo hidden aspect-square w-full overflow-hidden rounded-full border border-line lg:block">
      <Image
        src={portrait}
        alt="Portrait of Zain Iqbal"
        widths={[240, 480]}
        sizes="15rem"
        loading="eager"
        class="size-full object-cover"
      />
    </div>
  </section>

  <section id="work" class="container-page scroll-mt-20 py-10" aria-labelledby="work-h">
    <h2 id="work-h" class="text-2xl font-bold sm:text-3xl">{hire.workTitle}</h2>
    <p class="mt-2 max-w-[64ch] text-ink-2">{hire.workNote}</p>
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      {cards.map((p) => <ClientProjectCard project={p} />)}
    </div>
  </section>

  <section class="container-page py-10" aria-labelledby="svc-h">
    <h2 id="svc-h" class="text-2xl font-bold sm:text-3xl">{hire.specialitiesTitle}</h2>
    <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        hire.services.map((s) => (
          <li class="card card-hover reveal p-6">
            <h3 class="text-lg font-semibold">{s.title}</h3>
            <p class="mt-2 text-ink-2">{s.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="how" class="container-page scroll-mt-20 py-10" aria-labelledby="how-h">
    <h2 id="how-h" class="text-2xl font-bold sm:text-3xl">How we’d work together</h2>
    <ol class="mt-6 grid gap-5 md:grid-cols-4">
      {
        hire.steps.map((s, i) => (
          <li class="card card-hover reveal p-5">
            <span class="font-mono text-sm text-accent">0{i + 1}</span>
            <h3 class="mt-2 font-semibold">{s.title}</h3>
            <p class="mt-1 text-sm text-ink-2">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container-page py-10" aria-labelledby="exp-h">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
      <h2 id="exp-h" class="text-2xl font-bold sm:text-3xl">{hire.experienceTitle}</h2>
      <a href="/about/" class="link-arrow text-sm font-semibold text-accent">
        Full background <span aria-hidden="true">→</span>
      </a>
    </div>
    <ul class="card reveal mt-6 divide-y divide-line">
      {
        experience.map((e) => (
          <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 px-5 py-4">
            <span>
              <span class="font-semibold">{e.data.title}</span>
              <span class="text-muted"> · {e.data.org}</span>
            </span>
            <span class="eyebrow">{formatPeriod(e.data.start, e.data.end)}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="contact" class="container-page scroll-mt-20 py-10" aria-labelledby="contact-h">
    <div class="card reveal flex flex-col gap-5 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
      <div>
        <h2 id="contact-h" class="text-2xl font-bold">{hire.closingTitle}</h2>
        <p class="mt-1 text-ink-2">{hire.closingText}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={mail} class="btn btn-primary min-h-11">Discuss your project</a>
        <button type="button" class="btn btn-ghost min-h-11" data-copy={profile.email}>Copy email address</button>
      </div>
    </div>
  </section>
</Base>

<script>
  // For visitors without a mail app: copy the address instead of opening mailto.
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const label = btn.textContent;
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? "");
        btn.textContent = "Copied ✓";
      } catch {
        btn.textContent = btn.dataset.copy ?? "";
      }
      setTimeout(() => (btn.textContent = label), 2500);
    });
  });
</script>
