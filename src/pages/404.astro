---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="This page does not exist." noindex>
  <section class="container-page py-24">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 text-4xl font-bold">This page doesn’t exist</h1>
    <p class="mt-3 text-ink-2">The link may be old. Everything I’ve built is on the work page.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/work/" class="btn btn-primary">See my work</a>
      <a href="/" class="btn btn-ghost">Home</a>
    </div>
  </section>
</Base>
