---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Timeline from "../components/Timeline.astro";
import { Image } from "astro:assets";
import portrait from "../assets/profilepicture.webp";
import { profile } from "../data/profile";
import { home } from "../data/copy";
import { byOrder } from "../lib/format";
import { SPECIALITIES, STACK, type Skill } from "../lib/skills";
import SkillLink from "../components/SkillLink.astro";

const all = (await getCollection("projects")).sort(byOrder);
const featured = all.filter((p) => p.data.featured);
// The top client project leads full width, the other client apps sit in pairs,
// and independent work gets its own full-width row under a heading.
const clientWork = featured.filter((p) => p.data.kind === "client");
// A full-width lead card needs an image to fill it. Without one, every client
// project gets the same compact card.
const leadHasImage = Boolean(clientWork[0]?.data.cover) || (clientWork[0]?.data.screens.length ?? 0) > 0;
const leadProject = leadHasImage ? clientWork[0] : undefined;
const clientRest = leadHasImage ? clientWork.slice(1) : clientWork;
const independent = featured.filter((p) => p.data.kind !== "client");
const projectsFor = (s: Skill) => all.filter(s.matches);
const countOf = (s: Skill) => projectsFor(s).length;
// How many projects a speciality lists on this page before pointing to /work.
const PANEL_LIMIT = 4;
// Extra copies of the tech stack that make the moving row loop without a gap.
const STACK_COPIES = 3;
---

<Base title={profile.name} description={home.metaDescription}>
  <!-- 10-second layer: who, what, next step -->
  <section class="container-page grid items-center gap-10 pt-12 pb-10 sm:pt-16 lg:grid-cols-[1fr_17rem] lg:pb-14">
    <div class="hero-in">
    <p class="eyebrow">{home.eyebrow}</p>
    <h1 class="mt-4 max-w-[20ch] text-4xl font-bold sm:text-5xl">
      {home.title}
    </h1>
    <p class="mt-5 max-w-[60ch] text-lg text-ink-2">{home.lede}</p>


    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/work/" class="btn btn-primary">See my work</a>
      <a href="/cv/" class="btn btn-ghost">View CV</a>
    </div>
    </div>
    <div class="hero-photo hidden aspect-square w-full overflow-hidden rounded-full border border-line lg:block">
      <Image
        src={portrait}
        alt="Portrait of Zain Iqbal"
        widths={[320, 640]}
        sizes="17rem"
        loading="eager"
        class="size-full object-cover"
      />
    </div>
  </section>


  <section class="container-page py-10" aria-labelledby="sum-h">
    <div class="card reveal grid gap-6 p-6 sm:p-8 lg:grid-cols-[1fr_22rem]">
      <!-- min-w-0 keeps the moving row from stretching this column. -->
      <div class="min-w-0">
        <h2 id="sum-h" class="text-2xl font-bold">{home.summaryTitle}</h2>
        <p class="mt-3 max-w-[64ch] text-ink-2">{home.summary}</p>
        <div class="marquee mt-5">
          <ul class="marquee-track" aria-label="Tech stack">
            {STACK.map((s) => <li><SkillLink skill={s.key} label={s.label} count={countOf(s)} /></li>)}
            {
              Array.from({ length: STACK_COPIES }, () =>
                STACK.map((s) => (
                  <li class="marquee-copy" aria-hidden="true">
                    <SkillLink skill={s.key} label={s.label} count={countOf(s)} duplicate />
                  </li>
                )),
              )
            }
          </ul>
        </div>
      </div>
      <div class="min-w-0" data-skill-picker>
        <h3 class="text-sm font-semibold">Specialities</h3>
        <ul class="mt-3 flex flex-wrap gap-2">
          {SPECIALITIES.map((s) => <li><SkillLink skill={s.key} label={s.label} count={countOf(s)} /></li>)}
        </ul>
        <p class="mt-4 text-xs text-muted" data-skill-hint>Click any skill to see the projects behind it.</p>
        <div aria-live="polite">
          {
            SPECIALITIES.map((s) => {
              const projects = projectsFor(s);
              return (
                <div
                  id={`skill-panel-${s.key}`}
                  class="skill-panel mt-3 rounded-xl border border-line bg-surface-2 p-4"
                  data-skill-panel={s.key}
                  hidden
                >
                  <p class="text-sm font-semibold">
                    {s.label}
                    <span class="font-normal text-muted">
                      {" "}
                      · {projects.length} project{projects.length === 1 ? "" : "s"}
                    </span>
                  </p>
                  <ul class="mt-2 grid gap-1.5 text-sm">
                    {projects.slice(0, PANEL_LIMIT).map((p) => (
                      <li>
                        <a href={`/work/${p.id}/`} class="link-arrow text-ink-2 hover:text-ink">
                          {p.data.title} <span aria-hidden="true">→</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                  <a href={`/work/?skill=${s.key}`} class="mt-3 inline-block text-sm font-semibold text-accent">
                    {projects.length > PANEL_LIMIT ? `See all ${projects.length} on the Work page` : "Open these on the Work page"}
                  </a>
                </div>
              );
            })
          }
        </div>
      </div>
    </div>
  </section>

  <section class="container-page py-12" aria-labelledby="work-h">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
      <h2 id="work-h" class="text-2xl font-bold sm:text-3xl">Selected work</h2>
      <a href="/work/" class="link-arrow text-sm font-semibold text-accent">All projects <span aria-hidden="true">→</span></a>
    </div>
    {leadProject && <ProjectCard project={leadProject} variant="feature" />}
    <div class:list={["grid gap-6", leadProject ? "mt-6 lg:grid-cols-2" : "md:grid-cols-2 lg:grid-cols-3"]}>
      {clientRest.map((p) => <ProjectCard project={p} variant="compact" />)}
    </div>
    {
      independent.length > 0 && (
        <>
          <h3 class="mt-14 mb-5 text-xl font-bold">Independent engineering</h3>
          <div class="grid gap-6">
            {independent.map((p) => <ProjectCard project={p} variant="feature" headingLevel="h4" />)}
          </div>
        </>
      )
    }
  </section>

  <section class="container-page py-12" aria-labelledby="path-h">
    <h2 id="path-h" class="mb-6 text-2xl font-bold sm:text-3xl">How I got here</h2>
    <Timeline compact />
  </section>

  <section class="container-page py-12" aria-labelledby="contact-h">
    <div class="card reveal flex flex-col gap-5 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
      <div>
        <h2 id="contact-h" class="text-2xl font-bold">{home.contactTitle}</h2>
        <p class="mt-1 text-ink-2">{home.contactText}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={`mailto:${profile.email}`} class="btn btn-primary">Email me</a>
        <a href={profile.linkedin} rel="noopener" class="btn btn-ghost">LinkedIn</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Specialities: picking a skill lists its projects on this page. Without JS
  // the chips stay plain links to the Work page.
  const picker = document.querySelector<HTMLElement>("[data-skill-picker]");

  if (picker) {
    const chips = [...picker.querySelectorAll<HTMLAnchorElement>("a[data-skill]")];
    const panels = [...picker.querySelectorAll<HTMLElement>("[data-skill-panel]")];

    const select = (key: string) => {
      chips.forEach((chip) => {
        const on = chip.dataset.skill === key;
        chip.classList.toggle("is-selected", on);
        chip.setAttribute("aria-expanded", String(on));
      });
      panels.forEach((panel) => (panel.hidden = panel.dataset.skillPanel !== key));
    };

    chips.forEach((chip) => {
      chip.setAttribute("aria-controls", `skill-panel-${chip.dataset.skill}`);
      chip.addEventListener("click", (event) => {
        // Ctrl/Cmd/Shift-click still opens the Work page in a new tab or window.
        if (event.metaKey || event.ctrlKey || event.shiftKey) return;
        event.preventDefault();
        select(chip.dataset.skill ?? "");
      });
    });

    const hint = picker.querySelector("[data-skill-hint]");
    if (hint) hint.textContent = "Pick a skill to see the projects behind it.";
    if (chips[0]) select(chips[0].dataset.skill ?? "");
  }
</script>
