---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { LAYERS } from "../../content.config";
import { LAYER_LABEL, byOrder } from "../../lib/format";
import { SKILLS, skillKeys } from "../../lib/skills";

const all = (await getCollection("projects")).sort(byOrder);
const groups = [
  { title: "Client work", kinds: ["client"] },
  { title: "Independent engineering", kinds: ["personal"] },
  { title: "Early work: internship, university and courses", kinds: ["internship", "academic", "course"], collapsed: true },
].map((g) => ({ ...g, items: all.filter((p) => g.kinds.includes(p.data.kind)) }));
const usedLayers = LAYERS.filter((l) => all.some((p) => p.data.layers.includes(l)));
---

<Base title="Work" description="Every project Zain Iqbal worked on, with what he personally built in each.">
  <section class="container-page pt-14 pb-8">
    <p class="eyebrow">Work</p>
    <h1 class="mt-3 text-4xl font-bold">Projects and what I built in each</h1>
    <p class="mt-3 max-w-[62ch] text-ink-2">
      Every card lists my role, the parts I built myself, and what the rest of the team built.
      Filter by the kind of work you care about.
    </p>

    <div class="mt-6 flex flex-wrap gap-2" role="group" aria-label="Filter projects by layer" data-filters hidden>
      <button type="button" class="chip cursor-pointer" aria-pressed="true" data-layer="all">All</button>
      {
        usedLayers.map((l) => (
          <button type="button" class="chip cursor-pointer" aria-pressed="false" data-layer={l}>
            {LAYER_LABEL[l]}
          </button>
        ))
      }
    </div>
    <p class="mt-4 text-sm text-ink-2" data-skill-note hidden>
      <span data-skill-text></span>
      <button type="button" class="ml-2 font-semibold text-accent underline underline-offset-2" data-skill-clear>Show all</button>
    </p>
    <p class="sr-only" aria-live="polite" data-filter-status></p>
    <script type="application/json" data-skill-labels set:html={JSON.stringify(Object.fromEntries(SKILLS.map((s) => [s.key, s.label])))} />
  </section>

  {
    groups.map(
      (g) =>
        g.items.length > 0 && (
          <section class="container-page py-8" data-group>
            {"collapsed" in g ? (
              <details data-early>
                <summary class="cursor-pointer text-xl font-bold">
                  {g.title} <span class="text-base font-normal text-muted">({g.items.length})</span>
                </summary>
                <div class="mt-5 grid gap-6 lg:grid-cols-2">
                  {g.items.map((p) => (
                    <div data-layers={p.data.layers.join(" ")} data-skills={skillKeys(p).join(" ")}>
                      <ProjectCard project={p} />
                    </div>
                  ))}
                </div>
              </details>
            ) : (
              <>
                <h2 class="mb-5 text-xl font-bold">{g.title}</h2>
                <div class="grid gap-6 lg:grid-cols-2">
                  {g.items.map((p) => (
                    <div data-layers={p.data.layers.join(" ")} data-skills={skillKeys(p).join(" ")}>
                      <ProjectCard project={p} />
                    </div>
                  ))}
                </div>
              </>
            )}
          </section>
        ),
    )
  }
</Base>

<style>
  [aria-pressed="true"] {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }
</style>

<script>
  // Progressive enhancement: without JS every project is simply visible.
  const bar = document.querySelector<HTMLElement>("[data-filters]");
  const status = document.querySelector<HTMLElement>("[data-filter-status]");
  const note = document.querySelector<HTMLElement>("[data-skill-note]");
  const noteText = document.querySelector<HTMLElement>("[data-skill-text]");
  const labels: Record<string, string> = JSON.parse(document.querySelector("[data-skill-labels]")?.textContent ?? "{}");
  if (bar) {
    bar.hidden = false;
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>("button")];
    const cards = [...document.querySelectorAll<HTMLElement>("[data-layers]")];
    const has = (c: HTMLElement, attr: "layers" | "skills", key: string) => (c.dataset[attr] ?? "").split(" ").includes(key);

    // Show only the matching cards and return how many are visible.
    const show = (match: (c: HTMLElement) => boolean, filtered: boolean) => {
      let shown = 0;
      cards.forEach((c) => {
        c.hidden = !match(c);
        if (!c.hidden) shown++;
      });
      document.querySelectorAll<HTMLElement>("[data-group]").forEach((g) => {
        g.hidden = !g.querySelector("[data-layers]:not([hidden])");
      });
      // A filtered view should never hide matches inside the collapsed group.
      if (filtered) document.querySelectorAll<HTMLDetailsElement>("[data-early]").forEach((d) => (d.open = true));
      if (status) status.textContent = `${shown} projects shown`;
      return shown;
    };

    const pressLayer = (layer: string) => {
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.layer === layer)));
      if (note) note.hidden = true;
      show((c) => layer === "all" || has(c, "layers", layer), layer !== "all");
    };

    const clearSkill = (layer: string) => {
      history.replaceState(null, "", location.pathname);
      pressLayer(layer);
    };
    bar.addEventListener("click", (ev) => {
      const btn = (ev.target as HTMLElement).closest("button");
      if (btn) clearSkill(btn.dataset.layer ?? "all");
    });
    document.querySelector("[data-skill-clear]")?.addEventListener("click", () => clearSkill("all"));

    // Skill links from the home page arrive as /work/?skill=react.
    const skill = new URLSearchParams(location.search).get("skill");
    if (skill && buttons.some((b) => b.dataset.layer === skill)) {
      pressLayer(skill);
    } else if (skill && labels[skill]) {
      buttons.forEach((b) => b.setAttribute("aria-pressed", "false"));
      const shown = show((c) => has(c, "skills", skill), true);
      if (note && noteText) {
        noteText.textContent = `${shown} ${shown === 1 ? "project uses" : "projects use"} ${labels[skill]}.`;
        note.hidden = false;
      }
    }
  }
</script>
